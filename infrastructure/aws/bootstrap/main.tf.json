{
  "terraform": {
    "required_version": "~> 1.17.0",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "6.72.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "eu-north-1",
      "allowed_account_ids": [
        "968077439279"
      ]
    }
  },
  "resource": {
    "aws_s3_bucket": {
      "state": {
        "bucket": "paysim-tfstate-968077439279-eu-north-1",
        "force_destroy": false,
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_public_access_block": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "block_public_acls": true,
        "ignore_public_acls": true,
        "block_public_policy": true,
        "restrict_public_buckets": true,
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_ownership_controls": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "rule": [
          {
            "object_ownership": "BucketOwnerEnforced"
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_versioning": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "versioning_configuration": [
          {
            "status": "Enabled"
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_server_side_encryption_configuration": {
      "state": {
        "bucket": "${aws_s3_bucket.state.id}",
        "rule": [
          {
            "apply_server_side_encryption_by_default": [
              {
                "sse_algorithm": "AES256"
              }
            ],
            "blocked_encryption_types": [
              "SSE-C"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_s3_bucket_policy": {
      "tls_only": {
        "bucket": "${aws_s3_bucket.state.id}",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"DenyInsecureTransport\", \"Effect\": \"Deny\", \"Principal\": \"*\", \"Action\": \"s3:*\", \"Resource\": [\"arn:aws:s3:::paysim-tfstate-968077439279-eu-north-1\", \"arn:aws:s3:::paysim-tfstate-968077439279-eu-north-1/*\"], \"Condition\": {\"Bool\": {\"aws:SecureTransport\": \"false\"}}}]}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  }
}
